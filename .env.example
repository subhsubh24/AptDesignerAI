NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── AI Provider Selection ───────────────────────────────────────
# "deepseek" (default) — text-only agents use DeepSeek V4 Flash ($0.14/M in, $0.28/M out)
#                         vision agents + image gen + computer use stay on Gemini
# "gemini" — all agents use Gemini (legacy, higher cost)
AI_PROVIDER=deepseek

# ─── DeepSeek API (required unless AI_PROVIDER=gemini) ──────────
# Get key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Max concurrent DeepSeek calls (default: 20)
# DEEPSEEK_MAX_CONCURRENCY=20
# Per-call timeout in ms (default: 120000)
# DEEPSEEK_CALL_TIMEOUT_MS=120000

# ─── Gemini Context Caching ──────────────────────────────────────
# Caches system prompts + room images across calls to reduce token
# usage. Enabled by default; set to 0 to disable.
# ENABLE_GEMINI_CACHE=0

# ─── Tavily Search API ──────────────────────────────────────────
# Product search + extraction. 1000 free credits/month.
# Get key at https://app.tavily.com
# REQUIRED in production — the search/sourcing pipeline throws without it, so
# assertProductionEnv() fails the boot loudly rather than 500-ing the first search.
# (The CI journeys boot, E2E_AUTH_STACK="1", is exempt — its routes never call Tavily.)
TAVILY_API_KEY=
# Rate tier: "dev" (100 RPM) or "prod" (1000 RPM). Default: dev
# TAVILY_RATE_TIER=dev
# Override the tier's default concurrency/RPM caps (dev: 5 conc / 80 rpm,
# prod: 30 conc / 800 rpm). Leave unset to use the tier default.
# TAVILY_CONCURRENCY=5
# TAVILY_RPM=80
# Minimum relevance score (0-1) a Tavily result must clear to be kept. Default: 0.3
# TAVILY_MIN_RELEVANCE=0.3

# ─── Pipeline stage toggles + tuning (all optional — safe defaults) ──
# Ceiling text model for escalation paths. Default: gemini-3.5-flash
# TEXT_CEILING_MODEL=gemini-3.5-flash
# Timeout (ms) for a semantic-extract LLM call before falling back to regex.
# Default: 20000
# SEMANTIC_CALL_TIMEOUT_MS=20000
# Skip the semantic-extract LLM pass entirely (pure regex parsing). Default: off.
# DISABLE_SEMANTIC_EXTRACT=1
# Post-search + design coordinator agent stages. Default: on (set to "0" or
# "false" to disable).
# ENABLE_POST_SEARCH_COORDINATOR=1
# ENABLE_DESIGN_COORDINATOR=1
# Re-rank search results with an extra LLM pass. Default: off.
# ENABLE_RERANK=1

# ─── Gemini Computer Use (product verification) ──────────────────
# When these Browserbase creds are present, every product search
# automatically verifies the top candidate per category against the
# live retailer page (price, stock, dimensions). Leave unset to
# disable — the search pipeline silently falls back to snippet data.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: override the Computer Use model ID.
COMPUTER_USE_MODEL=
# Per-call timeout in ms for the agent loop's generateContent call (default: 60000)
# COMPUTER_USE_CALL_TIMEOUT_MS=60000

# ─── Growth execution engine (E7) ───────────────────────────────
# Owner setup runbook: docs/growth/CONNECT.md. Everything below is
# DRY-RUN / disabled until the corresponding value is supplied, so the
# engine is safe to deploy before any channel is connected.

# Email sending (Resend). Until RESEND_API_KEY is set the email lifecycle
# runs in dry-run (logs intent, sends nothing). Get a key + verify a sending
# domain at https://resend.com.
RESEND_API_KEY=
# From address for lifecycle emails (must be on a Resend-verified domain).
RESEND_FROM_EMAIL=
# Force dry-run (1) or live (0). Unset = dry-run unless RESEND_API_KEY is present.
# GROWTH_EMAIL_DRY_RUN=1
# Physical mailing address rendered in every marketing/lifecycle email footer
# (CAN-SPAM requirement). Until this is set, activation/win-back/paid-welcome
# sends stay dry-run even if RESEND_API_KEY is present (the transactional
# exceptions are the waitlist double-opt-in confirmation and password-reset
# emails, neither of which carries a footer).
EMAIL_PHYSICAL_ADDRESS=

# Shared secret protecting GET /api/internal/growth-metrics (the funnel-data
# pull the daily Growth Agent reads). The endpoint returns 503 until this is
# set. Generate a long random value, e.g. `openssl rand -hex 32`.
INTERNAL_METRICS_TOKEN=

# Shared secret authorizing the lifecycle-email cron routes (activation/
# habit/win-back — app/api/cron/*). Required in production so an unauthed
# caller can't trigger a mass send; requests without a matching
# `Authorization: Bearer <value>` are rejected. Generate a long random value.
CRON_SECRET=

# Per-user/day paid-API call ceiling (circuit breaker, G7). Default: 60.
# DAILY_PAID_CALL_LIMIT=60

# ─── Margin/cost observability (optional) ───────────────────────
# Streams per-call LLM cost telemetry to an external ingest endpoint. Unset =
# no-op (also disabled in CI / E2E_AUTH_STACK). Leave both unset locally.
# MARGIN_INGEST_KEY=
# MARGIN_INGEST_URL=

# ─── Billing — Stripe (web) + RevenueCat (mobile) ───────────────
# All values below are HUMAN-APPLIED go-live secrets/config (see PENDING_OPS.md).
# Leave unset for local dev — checkout errors (HTTP 500) rather than charging.
# Stripe secret key (web billing). Get it at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Stripe webhook signing secret — verifies the /api/billing/webhook payload.
# From the webhook endpoint's "Signing secret" in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for the paid tiers (create the Products/Prices in Stripe first).
STRIPE_PRICE_ID_APARTMENT=
STRIPE_PRICE_ID_PRO_MONTHLY=
# Pro Annual stays code-gated until ANNUAL_BILLING_ENABLED=true is set in the SAME
# deploy that applies migration 021 (the pro_annual tier CHECK constraint).
STRIPE_PRICE_ID_PRO_ANNUAL=
# ANNUAL_BILLING_ENABLED=true
# RevenueCat server secret key (mobile entitlement check). NEVER exposed to the
# client. Get it at https://app.revenuecat.com → Project → API keys.
REVENUECAT_SECRET_KEY=

# Cloudflare Turnstile — bot protection on the public waitlist form (G5).
# Disabled until BOTH are set: with neither, the widget renders nothing and the
# server fails open, so the form is unchanged. Get keys at
# https://dash.cloudflare.com → Turnstile (free).
# Server-side secret (siteverify). NEVER prefix with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=
# Public widget site key. NOTE: NEXT_PUBLIC_* values are inlined at BUILD time —
# you must REBUILD/redeploy after setting this for the widget to appear. Set this
# and TURNSTILE_SECRET_KEY together (one without the other breaks sign-up).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Pre-launch SITE GATE (E8). When set, the deployed app is held behind this
# password — random visitors see only the "coming soon + join the waitlist"
# page; the public marketing/legal/waitlist routes stay open. Unlock by visiting
# any URL with ?gate=<password> once (sets an httpOnly cookie). Leave UNSET to
# open the app to everyone (the launch state). Never commit a real value.
SITE_GATE_PASSWORD=
