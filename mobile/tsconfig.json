{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    },
    "jsx": "react-jsx",
    "lib": [
      "ES2020"
    ],
    "types": [
      "jest"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.css",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
